<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="format-detection" content="telephone=no">
<title>Comparativo de Orçamento, Perfecta Esquadrias</title>
<style>
:root{--bg:#f4f5f7;--card:#fff;--ink:#1d2330;--mut:#6b7280;--line:#e3e6eb;--acc:#1f4e79;--accs:#e7eef7;--up:#b42318;--down:#1a7f37;--wa:#25d366}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{margin:0;font-family:"Segoe UI",system-ui,-apple-system,BlinkMacSystemFont,Roboto,"Helvetica Neue",Arial,sans-serif;background:var(--bg);color:var(--ink);font-size:14px;line-height:1.35}
button,input{font-family:inherit}
button{-webkit-appearance:none;appearance:none;touch-action:manipulation}
.up{color:var(--up)}.down{color:var(--down)}
h1{font-size:20px;margin:0 0 4px}
.sub{color:var(--mut);margin-bottom:16px}
.note{color:var(--mut);font-size:12px;margin-top:12px}

/* ============ DESKTOP (tabela) ============ */
#desk{display:block}
#mob{display:none}
.wrap{max-width:1600px;margin:0 auto;padding:24px}
table{border-collapse:separate;border-spacing:0;width:100%;min-width:1280px;table-layout:fixed;background:var(--card);border:1px solid var(--line);border-radius:10px}
col.c-pos{width:44px}col.c-tipo{width:64px}col.c-dim{width:70px}col.c-qtd{width:52px}col.c-exc{width:66px}col.c-v{width:12.5%}col.c-esc{width:11.5%}
th,td{padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top;text-align:left}
/* cabeçalho congelado: cada th é "sticky" com o topo calculado em JS (funciona em Chrome, Edge, Firefox e Safari) */
thead th{position:-webkit-sticky;position:sticky;z-index:10;background:#fafbfc;font-size:12px;color:var(--mut)}
thead tr.tot th{background:var(--bg);border-bottom:none;padding:10px 6px;vertical-align:bottom}
thead tr.tot th:first-child{padding-left:0}
thead tr.tot th:last-child{padding-right:0}
.vl{border-left:1px solid var(--line)}
.esc{border-left:2px solid var(--acc)}
th.vh{color:var(--ink);text-align:center;font-size:13px}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
th.exch{text-align:center;color:var(--up)!important;border-left:1px solid var(--line)}

.box{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px;display:flex;flex-direction:column;box-shadow:0 2px 6px rgba(0,0,0,.04)}
.box>*{flex-shrink:0}
.box .lbl{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--mut);font-weight:400}
.box .nm{font-weight:600;color:var(--ink);font-size:13px;margin:2px 0 6px}
.box .val{font-size:clamp(14px,1.2vw,19px);white-space:nowrap;font-weight:700;color:var(--ink);font-variant-numeric:tabular-nums}
.box .qt{font-size:12px;color:var(--mut);font-weight:600;margin-top:2px}
.box .sq{font-size:12px;color:var(--ink);font-weight:700;margin-top:1px}
.box .xq{font-size:12px;color:var(--up);font-weight:600;margin-top:1px}
.box .dif{font-size:12px;margin-top:3px;white-space:nowrap;font-weight:400;font-variant-numeric:tabular-nums}
.box button{margin-top:auto;width:100%;padding:6px;border:1px solid var(--acc);background:#fff;color:var(--acc);border-radius:6px;cursor:pointer;font-size:12px}
.box button:hover{background:var(--accs)}
.box .sp{height:8px}
.box.custom{background:var(--acc);border-color:var(--acc)}
.box.custom .lbl,.box.custom .dif,.box.custom .qt{color:#d6e2f0}
.box.custom .nm,.box.custom .val,.box.custom .sq{color:#fff}
.box.custom .xq{color:#ffd2cc}
button.wa{background:var(--wa)!important;border-color:var(--wa)!important;color:#fff!important;font-weight:700;letter-spacing:.05em}
button.wa:hover{background:#1ebe5b!important}
.box.info{background:transparent;border:none;box-shadow:none;justify-content:flex-end;padding:0 4px}
.box.info .val{font-size:15px}
.box.info .ex{font-size:12px;color:var(--up);margin-top:4px;font-weight:600}

td.opt{cursor:pointer}
td.opt:hover{background:#f6f8fb}
td.opt.sel{background:var(--accs);box-shadow:inset 3px 0 0 var(--acc)}
.opt .pr{font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}
.opt .md{font-size:12px;color:var(--mut);margin-top:2px}
.opt .qd{font-size:11px;color:var(--mut)}
.opt .df{font-size:11px;font-variant-numeric:tabular-nums}
input[type=radio]{margin:0 6px 0 0;accent-color:var(--acc);vertical-align:-2px;pointer-events:none}
td.exc{text-align:center;cursor:pointer;border-left:1px solid var(--line);vertical-align:middle}
td.exc:hover{background:#fdf3f2}
td.exc input{accent-color:var(--up);width:16px;height:16px;margin:0}
td.exc.on{background:#fdecea;box-shadow:inset 3px 0 0 var(--up)}
tr.rowx td:not(.exc):not(.chosen){color:#a3a8b1}
tr.rowx td.p-loc{text-decoration:line-through}
tr.rowx td.opt .pr,tr.rowx td.opt .df span{color:#a3a8b1}
td.chosen{background:#fbfcfe;font-weight:700}
td.chosen .md{font-weight:400;font-size:12px;color:var(--mut)}
td.chosen .xl{color:var(--up);font-weight:700}

/* ============ CELULAR / TABLET (cartões) ============ */
@media (max-width:1000px){
  #desk{display:none}
  #mob{display:block}
  .wrap{padding:14px 12px calc(14px + env(safe-area-inset-bottom))}
  h1{font-size:18px}
  .mbar{position:-webkit-sticky;position:sticky;top:0;z-index:20;background:var(--acc);color:#fff;margin:0 -12px 12px;padding:10px 12px;padding-top:calc(10px + env(safe-area-inset-top));display:flex;align-items:center;gap:10px;box-shadow:0 2px 8px rgba(0,0,0,.15)}
  .mbar .mt{flex:1;min-width:0}
  .mbar .ml{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:#d6e2f0}
  .mbar .mv{font-size:19px;font-weight:700;white-space:nowrap}
  .mbar .mq{font-size:12px;color:#d6e2f0}
  .mbar .mq b{color:#fff}
  .mbar .mx{font-size:12px;color:#ffd2cc}
  .mbar button{border:none;border-radius:8px;padding:12px 16px;font-size:14px;cursor:pointer}
  .mvers{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}
  .mvers .box{padding:10px}
  .mvers .box .val{font-size:16px}
  .mvers .box button{padding:9px;font-size:13px;margin-top:8px}
  .mres{font-size:12px;color:var(--mut);margin-bottom:10px}
  .mres .ex{color:var(--up);font-weight:600}
  .pc{background:var(--card);border:1px solid var(--line);border-radius:10px;margin-bottom:10px;overflow:hidden}
  .pc .ph{padding:10px 12px;border-bottom:1px solid var(--line)}
  .pc .ph b{font-size:15px}
  .pc .ph .pd{font-size:12px;color:var(--mut);margin-top:2px}
  .pc.rowx .ph b,.pc.rowx .ph .pd{color:#a3a8b1}
  .pc.rowx .ph .loc{text-decoration:line-through}
  .po{display:flex;width:100%;text-align:left;align-items:flex-start;gap:8px;padding:10px 12px;border:none;border-bottom:1px solid var(--line);background:#fff;color:var(--ink);font-size:14px;cursor:pointer}
  .po:last-child{border-bottom:none}
  .po .pi{flex:1;min-width:0}
  .po .pv{font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:.03em}
  .po .pm{font-size:12px;color:var(--mut)}
  .po .pr{font-weight:700;white-space:nowrap;text-align:right;font-variant-numeric:tabular-nums}
  .po .df{font-size:11px;text-align:right}
  .po.sel{background:var(--accs);box-shadow:inset 4px 0 0 var(--acc)}
  .po.exb{color:var(--up);font-weight:600;justify-content:center}
  .po.exb.sel{background:#fdecea;box-shadow:inset 4px 0 0 var(--up)}
  .pc.rowx .po:not(.exb) .pr{color:#a3a8b1}
  .po .rd{width:18px;height:18px;border-radius:50%;border:2px solid #9aa3af;flex:0 0 18px;margin-top:1px;position:relative}
  .po.sel .rd{border-color:var(--acc)}
  .po.sel .rd:after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--acc)}
  .po.exb .rd{border-color:var(--up)}
  .po.exb.sel .rd:after{background:var(--up)}
}
@media print{
  #desk{display:block!important}#mob{display:none!important}
  .box button{display:none}body{background:#fff}thead th{position:static!important}
}
</style>
</head>
<body>
<div class="wrap">
<h1>Perfecta Esquadrias, Proposta Comercial</h1>
<div class="sub">Comparativo de orçamento por versão. Escolha uma versão em cada item para montar a composição personalizada. Use EXCLUIR para retirar um item do valor.</div>

<!-- Desktop -->
<div id="desk">
<table>
<colgroup><col class="c-pos"><col class="c-tipo"><col><col class="c-dim"><col class="c-dim"><col class="c-qtd"><col class="c-exc"><col class="c-v"><col class="c-v"><col class="c-v"><col class="c-v"><col class="c-esc"></colgroup>
<thead>
<tr class="tot" id="totais"></tr>
<tr><th colspan="6">Produto</th><th class="exch">&nbsp;</th><th class="vh vl" id="h0"></th><th class="vh vl" id="h1"></th><th class="vh vl" id="h2"></th><th class="vh vl" id="h3"></th><th class="vh esc">Escolhida</th></tr>
<tr><th>Pos.</th><th>Tipo</th><th>Localização</th><th class="num">Largura (mm)</th><th class="num">Altura (mm)</th><th class="num">Qtde</th><th class="exch">EXCLUIR</th>
<th class="vl">Valor / Modelo</th><th class="vl">Valor / Modelo</th><th class="vl">Valor / Modelo</th><th class="vl">Valor / Modelo</th><th class="esc num">Valor</th></tr>
</thead>
<tbody id="body"></tbody>
</table>
</div>

<!-- Celular / tablet -->
<div id="mob">
  <div class="mbar" id="mbar"></div>
  <div class="mvers" id="mvers"></div>
  <div class="mres" id="mres"></div>
  <div id="mlist"></div>
</div>

<div class="note">Diferenças calculadas sempre em relação à Versão 1 (Projeto): vermelho indica valor maior, verde indica economia. Item excluído conta como já decidido na quantidade selecionada, mas seu valor não é somado.</div>
</div>

<script>
"use strict";
var VERSOES=[{n:"Versão 1",d:"Projeto"},{n:"Versão 2",d:"Perfecta I"},{n:"Versão 3",d:"Perfecta II"},{n:"Versão 4",d:"Versão Simples"}];
const DADOS=[{"pos": "1", "tipo": "C1", "loc": "ESTAR", "larg": 4950, "alt": 3000, "qtd": 1, "v": [[37524.57, "3 Folhas High Design"], [37524.57, "3 folhas High Design"], [30447.14, "2 folhas High Design"], [28688.4, "3 Folhas Slide"]]}, {"pos": "3", "tipo": "C2", "loc": "SALA DE TV", "larg": 1600, "alt": 600, "qtd": 1, "v": [[14089.62, "2 Folhas correr"], [6445.96, "Max com motor 1600 x 600"], [12296.72, "Max com motor 3000x600"], [6445.96, "Max com motor 1600 x 600"]]}, {"pos": "5", "tipo": "C3/C10", "loc": "BANHO 01, 02, 03 E 04, LAVABO 01", "larg": 600, "alt": 1100, "qtd": 5, "v": [[18094.4, "Max 4 unid 600 x 1500"], [14713.84, "Max 600 x 1100"], [14713.84, "Max 600 x 1100"], [14713.84, "Max 4 unid 600 x 1500"]]}, {"pos": "6", "tipo": "C4", "loc": "JANTAR GOURMET", "larg": 6400, "alt": 3000, "qtd": 1, "v": [[43839.21, "3 Folhas High Design"], [43839.21, "3 Folhas High Design"], [43839.21, "3 Folhas High Design"], [35012.65, "3 Folhas Slide"]]}, {"pos": "7", "tipo": "C5", "loc": "GOURMET", "larg": 8500, "alt": 3000, "qtd": 1, "v": [[62848.82, "4 Folhas High Design"], [62848.82, "4 Folhas High Design"], [62848.82, "4 Folhas High Design"], [57416.66, "4 Folhas Slide"]]}, {"pos": "8", "tipo": "C6", "loc": "COZINHA", "larg": 1600, "alt": 3000, "qtd": 1, "v": [[20036.28, "2 Folhas correr"], [20036.28, "2 Folhas High Design"], [20036.28, "2 Folhas correr"], [17435.3, "2 Folhas Slide"]]}, {"pos": "9", "tipo": "C7", "loc": "COZINHA", "larg": 2000, "alt": 600, "qtd": 1, "v": [[7760.25, "2 Folhas+ 1 tela correr"], [7760.25, "2 Folhas+ 1 tela correr"], [7760.25, "2 Folhas+ 1 tela correr"], [7760.25, "2 Folhas+ 1 tela correr"]]}, {"pos": "10", "tipo": "C8", "loc": "LAVABO 01", "larg": 800, "alt": 2150, "qtd": 1, "v": [[5460.69, "Giro Lambri Alumínio"], [5460.69, "Giro Lambri Alumínio"], [5460.69, "Giro Lambri Alumínio"], [5460.69, "Giro Lambri Alumínio"]]}, {"pos": "11", "tipo": "C8B", "loc": "LAVABO 02", "larg": 800, "alt": 2150, "qtd": 1, "v": [[4024.63, "Giro Veneziana Alumínio"], [4024.63, "Giro Veneziana Alumínio"], [4024.63, "Giro Veneziana Alumínio"], [4024.63, "Giro Veneziana Alumínio"]]}, {"pos": "11.1", "tipo": "C10", "loc": "LAVABO", "larg": 600, "alt": 2800, "qtd": 1, "v": [[7965.31, "Max com Peitoril 600 x 2800"], [3678.46, "Max 600 x 1000"], [3678.46, "Max 600 x 1000"], [3678.46, "Max com Peitoril 600 x 2800"]]}, {"pos": "12", "tipo": "C11", "loc": "LAVANDERIA", "larg": 1950, "alt": 2150, "qtd": 1, "v": [[12540.5, "2 Folhas Correr"], [12540.5, "2 Folhas Correr"], [12540.5, "2 Folhas Correr"], [12540.5, "2 Folhas Correr"]]}, {"pos": "13", "tipo": "C12", "loc": "CIRCULAÇÃO", "larg": 1000, "alt": 2650, "qtd": 1, "v": [[8589.75, "Max com Peitoril 1000 X 2650"], [4708.27, "Fixo"], [4708.27, "Fixo"], [4708.27, "Max com Peitoril 1000 X 2650"]]}, {"pos": "14", "tipo": "C13", "loc": "DORMITÓRIO 04", "larg": 2500, "alt": 2700, "qtd": 1, "v": [[38720.29, "Persiana Motorizada 3000x2700"], [34974.28, "Persiana Motorizada 2500x2700"], [34974.28, "Persiana Motorizada 2500x2700"], [34974.28, "Persiana Motorizada 3000x2700"]]}, {"pos": "15", "tipo": "C14", "loc": "BANHO 05", "larg": 1000, "alt": 1100, "qtd": 1, "v": [[9238.51, "Max 1000 x 2300"], [5107.56, "Max 1000 x1100"], [5107.56, "Max 1000 x1100"], [5107.56, "Max 1000 x 2300"]]}, {"pos": "16", "tipo": "C15", "loc": "ESCRITÓRIO", "larg": 1400, "alt": 1500, "qtd": 1, "v": [[8799.86, "2 Folhas correr"], [8799.86, "2 Folhas correr"], [8799.86, "2 Folhas correr"], [8799.86, "2 Folhas correr"]]}, {"pos": "17", "tipo": "C16", "loc": "DORMITÓRIO 01, 02 E 03", "larg": 2000, "alt": 1500, "qtd": 2, "v": [[43034.62, "Persiana Motorizada 2400 X 1600"], [37340.02, "Persiana Motorizada 2000 X 1500"], [37340.02, "Persiana Motorizada 2000 X 1500"], [37340.02, "Persiana Motorizada 2400 X 1600"]]}, {"pos": "17", "tipo": "C16", "loc": "DORMITÓRIO 01, 02 E 03", "larg": 2000, "alt": 1500, "qtd": 1, "v": [[22056.39, "Persiana Motorizada 2500 X 1600"], [18670.01, "Persiana Motorizada 2000 X 1500"], [18670.01, "Persiana Motorizada 2000 X 1500"], [18607.01, "Persiana Motorizada 2500 X 1600"]]}, {"pos": "18", "tipo": "PR1", "loc": "GARAGEM / HALL DE ENTRADA", "larg": 6100, "alt": 3050, "qtd": 1, "v": [[74218.22, "Ripado Garagem"], [74218.22, "Ripado Garagem"], [74218.22, "Ripado Garagem"], [74218.22, "Ripado Garagem"]]}, {"pos": "19", "tipo": "PR2", "loc": "CORREDOR LATERAL ESQUERDO", "larg": 900, "alt": 2000, "qtd": 1, "v": [[3646.36, "Portão Lateral"], [3646.36, "Portão Lateral"], [3646.36, "Portão Lateral"], [3646.36, "Portão Lateral"]]}, {"pos": "20", "tipo": "PR3", "loc": "GARAGEM", "larg": 1300, "alt": 2000, "qtd": 1, "v": [[5334.22, "Portão Lateral"], [5334.22, "Portão Lateral"], [5334.22, "Portão Lateral"], [5334.22, "Portão Lateral"]]}, {"pos": "21", "tipo": "PR4", "loc": "SACADA", "larg": 5850, "alt": 2700, "qtd": 1, "v": [[43768.49, "Brise Suíte Master"], [43768.49, "Brise Suíte Master"], [43768.49, "Brise Suíte Master"], [43768.49, "Brise Suíte Master"]]}];
var EXC=4;                              // seleção "EXCLUIR"
var sel=DADOS.map(function(){return 0});// por item: 0 a 3 = versão, 4 = excluído

// Formatação própria (não depende do suporte a idioma do navegador)
function brl(v){var s=v<0?"-":"",p=Math.abs(v).toFixed(2).split(".");
  return s+"R$ "+p[0].replace(/\B(?=(\d{3})+(?!\d))/g,".")+","+p[1]}
function num(v){return String(v).replace(/\B(?=(\d{3})+(?!\d))/g,".")}
function dif(v){if(Math.abs(v)<0.005)return '<span>sem diferença</span>';
  return '<span class="'+(v>0?'up':'down')+'">'+(v>0?'+ ':'− ')+brl(Math.abs(v))+'</span>'}
function un(n){return n+" "+(n===1?"unidade":"unidades")}
function tot(i){return DADOS.reduce(function(s,x){return s+x.v[i][0]},0)}
var BASE=tot(0);

// Quantidade por versão: a planilha tem uma única coluna Qtde (F).
// C3/C10: Projeto com 5 unidades; Versões 2, 3 e 4 calculadas com 4 unidades (4 × R$ 3.678,46).
var QTDE_VERSAO=DADOS.map(function(x){return x.v.map(function(){return x.qtd})});
DADOS.forEach(function(x,r){if(x.tipo==="C3/C10")QTDE_VERSAO[r]=[5,4,4,4]});

var QT_TOTAL=DADOS.reduce(function(s,x){return s+x.qtd},0);    // total de peças, igual em todos os quadros
function qtVer(i){return QTDE_VERSAO.reduce(function(s,q){return s+q[i]},0)}   // soma da quantidade de cada versão
function qtSelVer(i){return DADOS.reduce(function(s,x,r){return s+(sel[r]===i?QTDE_VERSAO[r][i]:0)},0)}
function excl(){return DADOS.reduce(function(a,x,r){return sel[r]===EXC?{n:a.n+1,q:a.q+x.qtd}:a},{n:0,q:0})}
// Selecionada (personalizada): itens com versão + itens excluídos (excluído conta como decidido, nunca subtrai)
function qtSelTotal(){return DADOS.reduce(function(s,x,r){return s+(sel[r]===EXC?x.qtd:QTDE_VERSAO[r][sel[r]])},0)}
function valSelTotal(){return DADOS.reduce(function(s,x,r){return s+(sel[r]===EXC?0:x.v[sel[r]][0])},0)}
function difTxt(dc){return Math.abs(dc)<0.005?'igual ao Projeto':(dc>0?'+ ':'− ')+brl(Math.abs(dc))+'<br>vs Projeto'}

for(var k=0;k<4;k++)document.getElementById("h"+k).textContent=VERSOES[k].n+": "+VERSOES[k].d;

/* ---------- desktop ---------- */
function renderBody(){
  document.getElementById("body").innerHTML=DADOS.map(function(x,r){
    var ex=sel[r]===EXC;
    var opts=x.v.map(function(o,i){var on=sel[r]===i;
      return '<td class="opt vl'+(on?' sel':'')+'" data-r="'+r+'" data-i="'+i+'">'+
        '<div class="pr"><input type="radio" tabindex="-1" '+(on?'checked':'')+'>'+brl(o[0])+'</div>'+
        '<div class="md">'+o[1]+'</div><div class="qd">Qtde: '+QTDE_VERSAO[r][i]+'</div>'+
        (i>0?'<div class="df">'+dif(o[0]-x.v[0][0])+'</div>':'')+'</td>'}).join("");
    var esc=ex?'<span class="xl">Excluído</span><div class="md">não somado</div>'
              :brl(x.v[sel[r]][0])+'<div class="md">'+VERSOES[sel[r]].n+' · Qtde '+QTDE_VERSAO[r][sel[r]]+'</div>';
    return '<tr class="'+(ex?'rowx':'')+'"><td>'+x.pos+'</td><td>'+x.tipo+'</td><td class="p-loc">'+x.loc+'</td>'+
      '<td class="num">'+num(x.larg)+'</td><td class="num">'+num(x.alt)+'</td><td class="num">'+x.qtd+'</td>'+
      '<td class="exc'+(ex?' on':'')+'" data-r="'+r+'" data-i="'+EXC+'" title="Excluir este item do valor"><input type="radio" tabindex="-1" '+(ex?'checked':'')+'></td>'+
      opts+'<td class="chosen num esc">'+esc+'</td></tr>'}).join("");
}
function cardsVersoes(){
  return VERSOES.map(function(v,i){var t=tot(i);
    return '<div class="box vbox"><div class="lbl">'+v.n+'</div><div class="nm">'+v.d+'</div>'+
      '<div class="val">'+brl(t)+'</div><div class="qt">Qtde total: '+qtVer(i)+'</div>'+
      '<div class="sq">Selecionada: '+qtSelVer(i)+'</div>'+
      '<div class="dif">'+(i?dif(t-BASE)+'<br><span style="color:var(--mut)">vs Projeto</span>':'Referência<br>&nbsp;')+'</div>'+
      '<div class="sp"></div><button type="button" data-all="'+i+'">Aplicar a todos</button></div>'});
}
function renderTotais(){
  var e=excl(),c=cardsVersoes();
  var h='<th colspan="7"><div class="box info"><div class="lbl">Total geral</div><div class="val">'+DADOS.length+' itens · '+un(QT_TOTAL)+'</div>'+
    '<div class="ex">'+(e.n?'Excluídos: '+e.n+' '+(e.n===1?'item':'itens')+' ('+un(e.q)+')':'Nenhum item excluído')+'</div></div></th>';
  h+=c.map(function(b){return '<th>'+b+'</th>'}).join("");
  h+='<th><div class="box vbox custom"><div class="lbl">Personalizada</div><div class="nm">Escolhidas</div>'+
    '<div class="val">'+brl(valSelTotal())+'</div><div class="qt">Qtde total: '+QT_TOTAL+'</div>'+
    '<div class="sq">Selecionada: '+qtSelTotal()+'</div>'+
    '<div class="xq">'+(e.n?'Excluída: '+e.q:'&nbsp;')+'</div>'+
    '<div class="dif">'+difTxt(valSelTotal()-BASE)+'</div>'+
    '<div class="sp"></div><button type="button" class="wa" data-wa="1">ENVIAR</button></div></th>';
  document.getElementById("totais").innerHTML=h;
}
// iguala a altura dos quadros (botões sempre alinhados, qualquer fonte/sistema)
function igualarQuadros(){
  var bx=document.querySelectorAll("#totais .vbox"),m=0,i;
  for(i=0;i<bx.length;i++)bx[i].style.height="auto";
  for(i=0;i<bx.length;i++)m=Math.max(m,bx[i].offsetHeight);
  for(i=0;i<bx.length;i++)bx[i].style.height=m+"px";
}
// topo congelado: cada linha do cabeçalho fica presa logo abaixo da anterior
function fixarCabecalho(){
  var rows=document.querySelectorAll("#desk thead tr"),top=0;
  for(var r=0;r<rows.length;r++){
    var ths=rows[r].children;for(var j=0;j<ths.length;j++)ths[j].style.top=top+"px";
    top+=rows[r].getBoundingClientRect().height;
  }
}

/* ---------- celular ---------- */
function renderMobile(){
  var e=excl(),dc=valSelTotal()-BASE;
  document.getElementById("mbar").innerHTML='<div class="mt"><div class="ml">Personalizada</div><div class="mv">'+brl(valSelTotal())+'</div>'+
    '<div class="mq">Selecionada <b>'+qtSelTotal()+'</b> de '+QT_TOTAL+(e.n?' · <span class="mx">'+e.n+' excluído'+(e.n>1?'s':'')+'</span>':'')+'</div></div>'+
    '<button type="button" class="wa" data-wa="1">ENVIAR</button>';
  document.getElementById("mvers").innerHTML=cardsVersoes().join("");
  document.getElementById("mres").innerHTML=DADOS.length+' itens · '+un(QT_TOTAL)+' · '+difTxt(dc).replace('<br>',' ')+
    (e.n?' · <span class="ex">Excluídos: '+e.n+' ('+un(e.q)+')</span>':'');
  document.getElementById("mlist").innerHTML=DADOS.map(function(x,r){var ex=sel[r]===EXC;
    var ops=x.v.map(function(o,i){
      return '<button type="button" class="po'+(sel[r]===i?' sel':'')+'" data-r="'+r+'" data-i="'+i+'"><span class="rd"></span>'+
        '<span class="pi"><span class="pv">'+VERSOES[i].n+' · '+VERSOES[i].d+'</span><br><span class="pm">'+o[1]+' · Qtde '+QTDE_VERSAO[r][i]+'</span></span>'+
        '<span><span class="pr">'+brl(o[0])+'</span>'+(i>0?'<br><span class="df">'+dif(o[0]-x.v[0][0])+'</span>':'')+'</span></button>'}).join("");
    ops+='<button type="button" class="po exb'+(ex?' sel':'')+'" data-r="'+r+'" data-i="'+EXC+'"><span class="rd"></span>EXCLUIR</button>';
    return '<div class="pc'+(ex?' rowx':'')+'"><div class="ph"><b>'+x.pos+' · '+x.tipo+' · <span class="loc">'+x.loc+'</span></b>'+
      '<div class="pd">'+num(x.larg)+' × '+num(x.alt)+' mm · Qtde '+x.qtd+'</div></div>'+ops+'</div>'}).join("");
}

function render(){
  renderBody();renderTotais();renderMobile();
  if(document.getElementById("desk").offsetParent!==null){igualarQuadros();fixarCabecalho()}
}

/* ---------- eventos (um único ouvinte, funciona com mouse e toque) ---------- */
document.addEventListener("click",function(ev){
  var t=ev.target;
  var wa=t.closest("[data-wa]");if(wa){enviarWhatsApp();return}
  var all=t.closest("[data-all]");
  if(all){var v=+all.getAttribute("data-all");               // mantém os itens excluídos
    for(var r=0;r<sel.length;r++)if(sel[r]!==EXC)sel[r]=v;render();return}
  var c=t.closest("td.opt,td.exc,button.po");
  if(c){sel[+c.getAttribute("data-r")]=+c.getAttribute("data-i");render()}
});
var rz;window.addEventListener("resize",function(){clearTimeout(rz);rz=setTimeout(render,120)});
window.addEventListener("orientationchange",function(){setTimeout(render,250)});

/* ---------- WhatsApp: só os dados da coluna "Escolhida" ---------- */
function enviarWhatsApp(){
  var e=excl();
  var linhas=DADOS.map(function(x,r){var i=sel[r],id=x.pos+" "+x.tipo+" "+x.loc;
    return i===EXC?id+": EXCLUÍDO (não somado)":id+": "+brl(x.v[i][0]).replace(" "," ")+" ("+VERSOES[i].n+", Qtde "+QTDE_VERSAO[r][i]+")"});
  var msg="*Perfecta Esquadrias, Orçamento (versões escolhidas)*\n\n"+linhas.join("\n\n")+
    "\n\n*Qtde selecionada:* "+qtSelTotal()+" de "+QT_TOTAL+(e.n?" ("+e.n+" excluído"+(e.n>1?"s":"")+", sem valor)":"")+
    "\n*TOTAL:* "+brl(valSelTotal()).replace(" "," ");
  var url="https://api.whatsapp.com/send?text="+encodeURIComponent(msg);
  var toque=window.matchMedia&&window.matchMedia("(pointer:coarse)").matches;
  if(toque){window.location.href=url;return}                  // Android/iOS: abre o app direto
  var w=window.open(url,"_blank");if(!w)window.location.href=url; // Windows: nova aba (ou mesma, se pop-up bloqueado)
}

if(document.fonts&&document.fonts.ready)document.fonts.ready.then(render);
render();
</script>
